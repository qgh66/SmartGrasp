# Keep source code, scripts, configs, and docs tracked.
# Ignore datasets, downloaded models/repos, generated outputs, caches, and local env files.

# --- Local environment / editor files ---
.env
.env.*
api_config.json
!.env.example
.DS_Store
.vscode/
.idea/
.codex/
.agents/
AGENTS.md
*.pdf
*test/

# --- Python / build caches ---
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
build/
dist/
*.egg-info/
devel/
graspnet-workspace/

# --- Data and generated scene artifacts ---
/data/
/data*
/data copy/
/sample_data/
/scene_details/
/input
/temp
/temp/*
/testcase
/tests
/outputs/
*.parquet
*.npz
*.npy
*.zip

# --- Experiment outputs / logs / reports ---
/logs/
/runs/
/runs_detail/
/runs_reason_compare/
/runs_reason_current/
/analysis_report/
results.csv
branch_results.json
reason.txt
/rsr/data

